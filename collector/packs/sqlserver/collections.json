{
  "platform": "sqlserver",
  "description": "SQL Server collection pack. Each collector's `schema` is the emit contract: the ordered column list (== target table column order), each column's DuckDB type, and its source: 'stamp' (collector-filled identity/partition: instance_id/platform/collected_at/year/month/day), 'query' (from the SQL result by name — includes native database_id for database-level collectors), or 'const' (literal, default null). Keys are integers: instance_id from the registry, database_id native from sys.databases. No surrogate GUIDs, no source_query_id. CONFIGURABLE: a collector runs only if `enabled` is true or omitted (set \"enabled\": false to disable it without deleting the file/entry); `cadence` (5m|15m|hourly|daily) is the tier the runner's -Cadence filter selects (run one scheduled job per tier). Add a collector = drop a queries/<name>.sql + add an entry here; remove = delete the entry. No PowerShell change.",
  "collectors": [
    {
      "name": "metric_cpu",
      "target_table": "common.metric_cpu",
      "level": "instance",
      "cadence": "5m",
      "timeout_seconds": 5,
      "query": "queries/metric_cpu.sql",
      "schema": [
        { "name": "instance_id",         "type": "INTEGER",   "source": "stamp" },
        { "name": "platform",            "type": "VARCHAR",   "source": "stamp" },
        { "name": "collected_at",        "type": "TIMESTAMP", "source": "stamp" },
        { "name": "year",                "type": "SMALLINT",  "source": "stamp" },
        { "name": "month",               "type": "TINYINT",   "source": "stamp" },
        { "name": "day",                 "type": "TINYINT",   "source": "stamp" },
        { "name": "engine_cpu_percent",  "type": "SMALLINT",  "source": "query" },
        { "name": "other_cpu_percent",   "type": "SMALLINT",  "source": "query" },
        { "name": "system_idle_percent", "type": "SMALLINT",  "source": "query" }
      ]
    },
    {
      "name": "metric_memory_ple",
      "target_table": "common.metric_memory",
      "level": "instance",
      "cadence": "5m",
      "timeout_seconds": 5,
