{
  "platform": "sqlserver",
  "description": "SQL Server collection pack. Each collector's `schema` is the emit contract: the ordered column list (== target table column order), each column's DuckDB type, and its source: 'stamp' (collector-filled identity/partition: instance_id/platform/collected_at/year/month/day), 'query' (from the SQL result by name — includes native database_id for database-level collectors), or 'const' (literal, default null). Keys are integers: instance_id from the registry, database_id native from sys.databases. No surrogate GUIDs, no source_query_id.",
  "collectors": [
    {
      "name": "metric_cpu",
      "target_table": "common.metric_cpu",
      "level": "instance",
      "cadence": "5m",
      "timeout_seconds": 5,
      "query": "queries/metric_cpu.sql",
      "schema": [
        { "name": "instance_id",         "type": "INTEGER",   "source": "stamp" },
        { "name": "platform",            "type": "VARCHAR",   "source": "stamp" },
        { "name": "collected_at",        "type": "TIMESTAMP", "source": "stamp" },
        { "name": "year",                "type": "SMALLINT",  "source": "stamp" },
        { "name": "month",               "type": "TINYINT",   "source": "stamp" },
        { "name": "day",                 "type": "TINYINT",   "source": "stamp" },
        { "name": "engine_cpu_percent",  "type": "SMALLINT",  "source": "query" },
        { "name": "other_cpu_percent",   "type": "SMALLINT",  "source": "query" },
        { "name": "system_idle_percent", "type": "SMALLINT",  "source": "query" }
      ]
    },
    {
      "name": "metric_memory_ple",
      "target_table": "common.metric_memory",
      "level": "instance",
      "cadence": "5m",
      "timeout_seconds": 5,
      "query": "queries/metric_memory_ple.sql",
      "schema": [
        { "name": "instance_id",            "type": "INTEGER",      "source": "stamp" },
        { "name": "platform",               "type": "VARCHAR",      "source": "stamp" },
        { "name": "collected_at",           "type": "TIMESTAMP",    "source": "stamp" },
        { "name": "year",                   "type": "SMALLINT",     "source": "stamp" },
        { "name": "month",                  "type": "TINYINT",      "source": "stamp" },
        { "name": "day",                    "type": "TINYINT",      "source": "stamp" },
        { "name": "page_residency_seconds", "type": "BIGINT",       "source": "query" },
        { "name": "buffer_hit_ratio",       "type": "DECIMAL(5,2)", "source": "const" },
        { "name": "grants_pending",         "type": "INTEGER",      "source": "const" },
        { "name": "grants_outstanding",     "type": "INTEGER",      "source": "const" }
      ]
    },
    {
      "name": "metric_sessions",
      "target_table": "common.metric_sessions",
      "level": "instance",
      "cadence": "5m",
      "timeout_seconds": 5,
      "query": "queries/metric_sessions.sql",
      "schema": [
        { "name": "instance_id",     "type": "INTEGER",   "source": "stamp" },
        { "name": "platform",        "type": "VARCHAR",   "source": "stamp" },
        { "name": "collected_at",    "type": "TIMESTAMP", "source": "stamp" },
        { "name": "year",            "type": "SMALLINT",  "source": "stamp" },
        { "name": "month",           "type": "TINYINT",   "source": "stamp" },
        { "name": "day",             "type": "TINYINT",   "source": "stamp" },
        { "name": "active_sessions", "type": "INTEGER",   "source": "query" }
      ]
    },
    {
      "name": "metric_database_io",
      "target_table": "common.metric_database_io",
      "level": "database",
      "cadence": "15m",
      "timeout_seconds": 30,
      "query": "queries/metric_database_io.sql",
      "schema": [
        { "name": "instance_id",           "type": "INTEGER",   "source": "stamp" },
        { "name": "database_id",            "type": "INTEGER",   "source": "query" },
        { "name": "platform",              "type": "VARCHAR",   "source": "stamp" },
        { "name": "collected_at",          "type": "TIMESTAMP", "source": "stamp" },
        { "name": "year",                  "type": "SMALLINT",  "source": "stamp" },
        { "name": "month",                 "type": "TINYINT",   "source": "stamp" },
        { "name": "day",                   "type": "TINYINT",   "source": "stamp" },
        { "name": "last_restart_at",       "type": "TIMESTAMP", "source": "query" },
        { "name": "num_of_reads",          "type": "BIGINT",    "source": "query" },
        { "name": "num_of_bytes_read",     "type": "BIGINT",    "source": "query" },
        { "name": "io_stall_read_ms",      "type": "BIGINT",    "source": "query" },
        { "name": "num_of_writes",         "type": "BIGINT",    "source": "query" },
        { "name": "num_of_bytes_written",  "type": "BIGINT",    "source": "query" },
        { "name": "io_stall_write_ms",     "type": "BIGINT",    "source": "query" },
        { "name": "io_stall",              "type": "BIGINT",    "source": "query" },
        { "name": "size_on_disk_bytes",    "type": "BIGINT",    "source": "query" }
      ]
    },
    {
      "name": "metric_blocking",
      "target_table": "common.metric_blocking",
      "level": "database",
      "cadence": "5m",
      "timeout_seconds": 5,
      "query": "queries/metric_blocking.sql",
      "schema": [
        { "name": "instance_id",            "type": "INTEGER",   "source": "stamp" },
        { "name": "database_id",             "type": "INTEGER",   "source": "query" },
        { "name": "platform",                "type": "VARCHAR",   "source": "stamp" },
        { "name": "collected_at",            "type": "TIMESTAMP", "source": "stamp" },
        { "name": "year",                    "type": "SMALLINT",  "source": "stamp" },
        { "name": "month",                   "type": "TINYINT",   "source": "stamp" },
        { "name": "day",                     "type": "TINYINT",   "source": "stamp" },
        { "name": "blocked_session_count",   "type": "INTEGER",   "source": "query" }
      ]
    },
    {
      "name": "databases",
      "target_table": "common.databases",
      "level": "database",
      "cadence": "hourly",
      "timeout_seconds": 10,
      "query": "queries/databases.sql",
      "schema": [
        { "name": "instance_id",          "type": "INTEGER",   "source": "stamp" },
        { "name": "database_id",           "type": "INTEGER",   "source": "query" },
        { "name": "platform",             "type": "VARCHAR",   "source": "stamp" },
        { "name": "database_name",        "type": "VARCHAR",   "source": "query" },
        { "name": "create_date",          "type": "TIMESTAMP", "source": "query" },
        { "name": "compatibility_level",  "type": "SMALLINT",  "source": "query" },
        { "name": "collation_name",       "type": "VARCHAR",   "source": "query" },
        { "name": "recovery_model",       "type": "VARCHAR",   "source": "query" },
        { "name": "state",                "type": "VARCHAR",   "source": "query" },
        { "name": "user_access",          "type": "VARCHAR",   "source": "query" },
        { "name": "is_read_only",         "type": "BOOLEAN",   "source": "query" },
        { "name": "is_mirrored",          "type": "BOOLEAN",   "source": "query" },
        { "name": "is_alwayson",          "type": "BOOLEAN",   "source": "query" },
        { "name": "owner_name",           "type": "VARCHAR",   "source": "query" },
        { "name": "data_file_size_mb",    "type": "INTEGER",   "source": "query" },
        { "name": "log_file_size_mb",     "type": "INTEGER",   "source": "query" },
        { "name": "collected_at",         "type": "TIMESTAMP", "source": "stamp" }
      ]
    }
  ]
}
