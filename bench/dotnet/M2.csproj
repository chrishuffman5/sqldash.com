<Project Sdk="Microsoft.NET.Sdk">

  <!-- M2 bench runner: in-process DuckDB.NET writer + Microsoft.Data.SqlClient (SSPI) reader.
       DuckDB.NET.Data.Full bundles the native duckdb library (1.5.x line, matches the 1.5.3 catalog). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>m2</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

</Project>
