{
  "name": "sqldash-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SQLDash MCP server — exposes the DuckLake fleet store (problematic instances, instance detail, metric history, bounded ad-hoc query) to LLM clients.",
